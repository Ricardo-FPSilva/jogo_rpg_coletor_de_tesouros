[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://vitoria.gd" id="1"]
[ext_resource type="FontFile" path="res://assets/font/PressStart2P-Regular.ttf" id="2"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.1, 0.1, 0.4, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.4, 0.6, 1.0, 1)
content_margin_left = 12.0
content_margin_right = 12.0
content_margin_top = 8.0
content_margin_bottom = 8.0

