border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6, 0.8, 1.0, 1)
content_margin_left = 12.0
content_margin_right = 12.0
content_margin_top = 8.0
content_margin_bottom = 8.0

[node name="vitoria" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="fundo" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.03, 0.05, 0.15, 1)

[node name="estrelas" type="Label" parent="."]
offset_left = 20.0
offset_top = 50.0
offset_right = 390.0
offset_bottom = 90.0
text = "* * * * * *"
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1.0, 0.85, 0.1, 1)

[node name="titulo" type="Label" parent="."]
offset_left = 20.0
offset_top = 110.0
offset_right = 390.0
offset_bottom = 160.0
text = "VOCE GANHOU!"
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("2")
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.4, 1.0, 0.5, 1)

[node name="mensagem" type="Label" parent="."]
